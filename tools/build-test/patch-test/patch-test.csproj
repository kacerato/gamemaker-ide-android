<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplica host/IdePatches.cs + BuildPatches.cs (WinTrust.VerifySecurity no Build.dll,
       TestPlatform_Actual + ProcessHelper no IDE.dll) em copias e prova o resultado. AssemblyName igual ao do APK
       porque o patch referencia o host pelo nome do assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GmIde.Android</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\host\BuildPatches.cs" Link="BuildPatches.cs" />
    <Compile Include="..\..\..\host\IdePatches.cs" Link="IdePatches.cs" />
    <Compile Include="..\..\..\host\BuildBridge.cs" Link="BuildBridge.cs" />
    <Compile Include="..\..\..\host\RuntimeIntegrity.cs" Link="RuntimeIntegrity.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
